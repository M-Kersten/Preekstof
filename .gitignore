# project data (uploads, transcripts, renders)
projects/*
!projects/.gitkeep

# python
.venv/
__pycache__/
*.pyc

# frontend
frontend/node_modules/
frontend/node_modules/.tmp/

# editor / os
.DS_Store
*.log

# service recordings and their transcripts
services/

# What the black window said, kept so a failure leaves something to send.
logs/

# the person model is fetched on first use, like FFmpeg; the face model does ship with us
vision/person.onnx
vision/*.part

# launcher: the FFmpeg build it downloads. The Python in tools/ is part of the project and
# is tracked; CI runs tools/evaluate.py and a release is built by tools/release.py, and
# ignoring the whole folder meant neither of them was ever in the repository.
tools/ffmpeg/
tools/__pycache__/
config.env

# your church's own details, made on first start from templates/church.example.json.
# It used to ship filled in, which gave every new install another church's name.
templates/church.json

# how fast this particular computer writes out a service, learned from its own runs
templates/speed.json

# what the app noticed itself while reading clips back, on the way to the word list
templates/verbeteringen.json

# end screen: your own settings and the generated video (see templates/outro.example.json)
templates/outro.json
templates/outro.mp4
templates/outro.ass
# what building the end screen leaves behind, including a half-written render
templates/outro.bg.*
templates/outro.part.*
# the end screens of the other shapes, made from the same settings when first needed
templates/outro.4x5.*
templates/outro.1x1.*

# logos, brands, music and the word list: your own content (see the .example.json files)
templates/logos/*
!templates/logos/.gitkeep
templates/brands/
templates/music/*
!templates/music/.gitkeep
templates/woordenlijst.json
templates/outro-achtergrond.*

# evaluation set: real services are the church's own recordings and transcripts
evaluation/*/
!evaluation/voorbeeld-dienst/
evaluation/*.json
