# Preekstof settings. Copy is made automatically as config.env on first start.
# Lines starting with # are comments. You can also write a note behind a value, as long as
# there is a space in front of the #:  LLM_EFFORT=high   # sneller? zet hem op medium
# A setting the app does not recognise is reported in the black window and then ignored,
# so a typo here never stops the app from starting.

# Needed for "Full service" clip suggestions with Claude. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Or run the suggestions fully local with Ollama (https://ollama.com): set LLM_PROVIDER=ollama
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1

# Speech recognition model: tiny, base, small (default), medium, large-v3. Bigger is slower and better.
# WHISPER_MODEL=small

# Optional. A Hugging Face access token (https://huggingface.co/settings/tokens) makes the
# first download of the speech model quicker. The model is public, so it works fine without
# one; this only silences their advice to get one and lifts the download rate limit.
# HF_TOKEN=

# Which model is used for the clips of a service ticked as "nauwkeuriger uitschrijven".
# WHISPER_MODEL_ACCURATE=medium

# Which engine does the listening: auto, mlx, faster-whisper. On an Apple Silicon Mac with
# backend/requirements-mac.txt installed, auto uses the graphics chip, which is several times
# the processor at this. Name one of the two to settle it yourself, or to compare them.
# WHISPER_BACKEND=auto

# The whole service is scanned greedily to find the moments, and each clip you choose is
# written out again carefully. Set the scan to 5 if the found moments disappoint; it then
# listens to the whole service as carefully as the clips, and takes about twice as long.
# WHISPER_SCAN_BEAM=1
# WHISPER_CLIP_BEAM=5

# Which graphics card, if any, does the listening: cpu (default), cuda for an NVIDIA card, or
# auto to take the card when it works and fall back to the processor when it does not. Op cuda
# of auto haalt start.bat de NVIDIA-onderdelen er eenmalig bij, ongeveer een gigabyte. Lukt dat
# niet, dan start de app gewoon en gebeurt het uitschrijven op de processor.
# WHISPER_DEVICE=auto

# How much of the service goes into one call to the model. A sermon of forty minutes or less
# is a single call, which is the whole reason looking for moments takes a minute instead of
# eight. Lower this to cut the sermon into more, smaller calls again.
# LLM_PASSAGE_MINUTES=40

# How long Claude thinks before answering: low, medium (default), high, xhigh, max. With one
# call left, this is most of the wait. Raise it if the found moments disappoint.
# LLM_EFFORT=medium

# The estimate before "Beste momenten zoeken" is priced from Anthropic's dollar list and
# shown in euros. Set this when the rate has moved far enough to bother you.
# EUR_PER_USD=0.86

# How long a service recording is kept before the app clears it away by itself. The
# transcript, the found moments and your finished videos always stay. Set to 0 to never
# clean up automatically; the Opruimen panel then still lets you do it by hand.
# KEEP_WEEKS=4
